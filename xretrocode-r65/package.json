{
  "name": "xretrocode-r65",
  "displayName": "R65 Language",
  "description": "R65 language support for retro console development",
  "version": "0.0.1",
  "publisher": "XRetroCode",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:r65",
    "workspaceContains:**/*.r65"
  ],
  "main": "./out/main.js",
  "contributes": {
    "languages": [
      {
        "id": "r65",
        "aliases": [
          "R65",
          "r65"
        ],
        "extensions": [
          ".r65"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "r65",
        "scopeName": "source.r65",
        "path": "./syntaxes/r65.tmLanguage.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "r65",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The r65c command to run (build, check)"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional arguments"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "r65c",
        "owner": "r65",
        "source": "r65c",
        "fileLocation": [
          "autoDetect",
          "${workspaceRoot}"
        ],
        "severity": "error",
        "pattern": [
          {
            "regexp": "^(error|warning|type error|macro error|preprocessor error|codegen error|MIR error):\\s+(.+)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^\\s+-->\\s+(.+?):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "configuration": {
      "title": "R65",
      "properties": {
        "r65.compilerPath": {
          "type": "string",
          "default": "r65c",
          "description": "Path to the R65 compiler (r65c)"
        },
        "r65.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional include search paths for the compiler"
        },
        "r65.targetPlatform": {
          "type": "string",
          "enum": [
            "snes",
            "nes"
          ],
          "default": "snes",
          "description": "Target console platform"
        },
        "r65.cfgOptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Conditional compilation options (e.g., ['snes', 'debug'])"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "mocha --require out/test/setup.js 'out/test/**/*.test.js'"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.70.0",
    "mocha": "^10.0.0",
    "typescript": "^4.9.0",
    "vscode-textmate": "^9.0.0",
    "vscode-oniguruma": "^2.0.0"
  },
  "dependencies": {}
}
