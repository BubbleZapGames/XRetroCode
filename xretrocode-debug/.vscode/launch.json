{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Extension: XretroCode Debug",
      "type": "node",
      "request": "launch",
      "command": "npm:watch",
      "cwd": "${workspaceFolder}",
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
