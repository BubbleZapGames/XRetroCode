{
  "name": "xretrocode",
  "displayName": "XRetroCode",
  "description": "R65 language support and Mesen-GDB source-level debugging for retro console development",
  "version": "0.0.1",
  "publisher": "XRetroCode",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "activationEvents": [
    "onLanguage:r65",
    "workspaceContains:**/*.r65",
    "debug: xretrocode"
  ],
  "main": "./out/main.js",
  "contributes": {
    "languages": [
      {
        "id": "r65",
        "aliases": [
          "R65",
          "r65"
        ],
        "extensions": [
          ".r65"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "r65",
        "scopeName": "source.r65",
        "path": "./syntaxes/r65.tmLanguage.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "r65",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The r65c command to run (build, check)"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional arguments"
          }
        }
      },
      {
        "type": "xretrocode",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The build command to run (rom)"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional arguments passed to make"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "r65c",
        "owner": "r65",
        "source": "r65c",
        "fileLocation": [
          "autoDetect",
          "${workspaceRoot}"
        ],
        "severity": "error",
        "pattern": [
          {
            "regexp": "^(error|warning|type error|macro error|preprocessor error|codegen error|MIR error):\\s+(.+)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^\\s+-->\\s+(.+?):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "xretrocode.pickRom",
        "title": "Select ROM to Debug",
        "category": "XRetroCode"
      }
    ],
    "debuggers": [
      {
        "type": "xretrocode",
        "label": "XRetroCode",
        "program": "./mesen-dap",
        "runtime": "node",
        "variables": {},
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "romPath": {
                "type": "string",
                "description": "Path to the ROM file. Leave empty (or use ${command:xretrocode.pickRom}) to be prompted.",
                "default": ""
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop on entry point",
                "default": true
              },
              "mesenDapPath": {
                "type": "string",
                "description": "Path to the mesen-gdb executable (overrides the xretrocode.mesenDapPath setting).",
                "default": ""
              },
              "headless": {
                "type": "boolean",
                "description": "Run mesen-gdb without its game window (CI, remote sessions, tests).",
                "default": false
              },
              "dbgPath": {
                "type": "string",
                "description": "Path to the .dbg symbol file. Defaults to the ROM name with a .dbg extension, then <rom dir>/main.dbg.",
                "default": ""
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "Launch ROM",
            "type": "xretrocode",
            "request": "launch",
            "romPath": "${command:xretrocode.pickRom}",
            "stopOnEntry": true
          }
        ],
        "languages": [
          "r65"
        ],
        "configurationSnippets": [
          {
            "label": "XRetroCode: Launch ROM",
            "description": "Launch and debug a retro console ROM",
            "body": {
              "name": "Launch ROM",
              "type": "xretrocode",
              "request": "launch",
              "romPath": "^\"\\${command:xretrocode.pickRom}\"",
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "r65"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "XRetroCode",
      "properties": {
        "r65.compilerPath": {
          "type": "string",
          "default": "r65c",
          "description": "Path to the R65 compiler (r65c)"
        },
        "r65.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional include search paths for the compiler"
        },
        "r65.targetPlatform": {
          "type": "string",
          "enum": [
            "snes",
            "nes"
          ],
          "default": "snes",
          "description": "Target console platform"
        },
        "r65.cfgOptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Conditional compilation options (e.g., ['snes', 'debug'])"
        },
        "xretrocode.mesenDapPath": {
          "type": "string",
          "default": "",
          "description": "Path to mesen-dap executable"
        },
        "xretrocode.buildBeforeLaunch": {
          "type": "boolean",
          "default": true,
          "description": "Run `make` in the workspace folder before starting a debug session. Applies to any project with a makefile."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "mocha --require out/test/setup.js 'out/test/**/*.test.js'",
    "test:e2e": "npm run compile && node ./out/e2e/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.70.0",
    "@vscode/test-electron": "^2.4.1",
    "mocha": "^11.7.5",
    "typescript": "^4.9.0",
    "vscode-oniguruma": "^2.0.0",
    "vscode-textmate": "^9.0.0"
  }
}
