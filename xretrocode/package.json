{
  "name": "xretrocode",
  "displayName": "XRetroCode",
  "description": "R65 language support and Mesen-GDB source-level debugging for retro console development",
  "version": "0.4.1",
  "publisher": "BubbleZapGamesLLC",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BubbleZapGames/XRetroCode",
    "directory": "xretrocode"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "activationEvents": [
    "onLanguage:r65",
    "workspaceContains:**/*.r65",
    "onDebugResolve:xretrocode",
    "onDebugInitialConfigurations",
    "onCommand:xretrocode.setupToolchain",
    "onView:xretrocode.disassembly"
  ],
  "main": "./out/main.js",
  "contributes": {
    "languages": [
      {
        "id": "r65",
        "aliases": [
          "R65",
          "r65"
        ],
        "extensions": [
          ".r65"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "retroasm",
        "aliases": [
          "Retro Assembly",
          "retroasm"
        ],
        "extensions": [
          ".s",
          ".asm",
          ".inc"
        ],
        "configuration": "./asm-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "r65",
        "scopeName": "source.r65",
        "path": "./syntaxes/r65.tmLanguage.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "r65",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The r65c command to run (build, check)"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional arguments"
          }
        }
      },
      {
        "type": "xretrocode",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The build command to run (rom)"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional arguments passed to make"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "r65c",
        "owner": "r65",
        "source": "r65c",
        "fileLocation": [
          "autoDetect",
          "${workspaceRoot}"
        ],
        "severity": "error",
        "pattern": [
          {
            "regexp": "^(error|warning|type error|macro error|preprocessor error|codegen error|MIR error):\\s+(.+)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^\\s+-->\\s+(.+?):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "xretrocode.pickRom",
        "title": "Select ROM to Debug",
        "category": "XRetroCode"
      },
      {
        "command": "xretrocode.goToMacroDefinition",
        "title": "Go to Macro Definition",
        "category": "XRetroCode"
      },
      {
        "command": "xretrocode.stepIntoMacro",
        "title": "Step Into (Macro Definition)",
        "category": "XRetroCode"
      },
      {
        "command": "xretrocode.setupToolchain",
        "title": "Install R65 Toolchain",
        "category": "XRetroCode"
      },
      {
        "command": "xretrocode.stepInstruction",
        "title": "Step Instruction",
        "category": "XRetroCode",
        "icon": "$(debug-line-by-line)",
        "enablement": "debugType == 'xretrocode' && debugState == 'stopped'"
      }
    ],
    "views": {
      "debug": [
        {
          "type": "webview",
          "id": "xretrocode.disassembly",
          "name": "Disassembly",
          "when": "debugType == 'xretrocode'"
        }
      ]
    },
    "keybindings": [
      {
        "key": "f11",
        "command": "xretrocode.stepIntoMacro",
        "when": "debugType == 'xretrocode' && debugState == 'stopped' && xretrocode.stepIntoMacro"
      },
      {
        "key": "alt+f11",
        "command": "xretrocode.stepInstruction",
        "when": "debugType == 'xretrocode' && debugState == 'stopped'"
      }
    ],
    "menus": {
      "debug/toolBar": [
        {
          "command": "xretrocode.stepInstruction",
          "when": "debugType == 'xretrocode'"
        }
      ],
      "editor/context": [
        {
          "command": "xretrocode.goToMacroDefinition",
          "when": "inDebugMode && editorLangId == r65",
          "group": "navigation"
        }
      ]
    },
    "debuggers": [
      {
        "type": "xretrocode",
        "label": "XRetroCode",
        "program": "./mesen-dap",
        "runtime": "node",
        "variables": {},
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "romPath": {
                "type": "string",
                "description": "Path to the ROM file. Leave empty (or use ${command:xretrocode.pickRom}) to be prompted.",
                "default": ""
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Break at the entry point instead of running",
                "default": false
              },
              "mesenDapPath": {
                "type": "string",
                "description": "Path to the mesen-gdb executable (overrides the xretrocode.mesenDapPath setting).",
                "default": ""
              },
              "headless": {
                "type": "boolean",
                "description": "Run mesen-gdb without its game window (CI, remote sessions, tests).",
                "default": false
              },
              "dbgPath": {
                "type": "string",
                "description": "Path to the symbol file: a cc65/ld65 .dbg (R65 and cc65 C) or a WLA-DX .sym (wlalink -S; add -A for source lines). Defaults to the newest .dbg in the ROM's folder, else the newest .sym there.",
                "default": ""
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "Launch ROM",
            "type": "xretrocode",
            "request": "launch",
            "romPath": "${command:xretrocode.pickRom}",
            "stopOnEntry": false
          }
        ],
        "languages": [
          "r65",
          "c",
          "cpp",
          "retroasm"
        ],
        "configurationSnippets": [
          {
            "label": "XRetroCode: Launch ROM",
            "description": "Launch and debug a retro console ROM",
            "body": {
              "name": "Launch ROM",
              "type": "xretrocode",
              "request": "launch",
              "romPath": "^\"\\${command:xretrocode.pickRom}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "r65"
      },
      {
        "language": "c"
      },
      {
        "language": "cpp"
      },
      {
        "language": "retroasm"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "XRetroCode",
      "properties": {
        "r65.compilerPath": {
          "type": "string",
          "default": "r65c",
          "description": "Path to the R65 compiler (r65c)"
        },
        "r65.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional include search paths for the compiler"
        },
        "r65.targetPlatform": {
          "type": "string",
          "enum": [
            "snes",
            "nes"
          ],
          "default": "snes",
          "description": "Target console platform"
        },
        "r65.cfgOptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Conditional compilation options (e.g., ['snes', 'debug'])"
        },
        "xretrocode.mesenDapPath": {
          "type": "string",
          "default": "",
          "description": "Path to mesen-dap executable"
        },
        "xretrocode.mesenFolder": {
          "type": "string",
          "default": "",
          "description": "The folder of a Mesen settings.json, for a portable Mesen. A debug session with a game window uses its key, video, audio and console settings. Empty: MesenCE's folder, then Mesen2's, in their usual places."
        },
        "xretrocode.checkToolchain": {
          "type": "boolean",
          "default": true,
          "description": "When an R65 file is opened, offer to install the R65 compiler (python -m r65.compiler.main) and WLA-DX if they're missing."
        },
        "xretrocode.buildBeforeLaunch": {
          "type": "boolean",
          "default": true,
          "description": "Run `make` in the workspace folder before starting a debug session. Applies to any project with a makefile."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && node -e \"for (const f of ['README.md', 'LICENSE']) require('fs').copyFileSync('../' + f, f)\"",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/BubbleZapGames/XRetroCode/blob/main --baseImagesUrl https://github.com/BubbleZapGames/XRetroCode/raw/main",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "mocha --require out/test/setup.js 'out/test/**/*.test.js'",
    "test:e2e": "npm run compile && node ./out/e2e/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.70.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.9.2",
    "mocha": "^11.7.5",
    "typescript": "^4.9.0",
    "vscode-oniguruma": "^2.0.0",
    "vscode-textmate": "^9.0.0"
  }
}
